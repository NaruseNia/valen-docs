{
  "name": "valen",
  "scopeName": "source.valen",
  "fileTypes": ["vln"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#fstrings" },
    { "include": "#chars" },
    { "include": "#keywords" },
    { "include": "#storage" },
    { "include": "#modifiers" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.documentation.valen", "match": "///.*$" },
        { "name": "comment.line.double-slash.valen", "match": "//.*$" },
        { "name": "comment.block.valen", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.valen",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.valen", "match": "\\\\." }
      ]
    },
    "fstrings": {
      "name": "string.interpolated.valen",
      "begin": "f\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.valen", "match": "\\\\." },
        {
          "name": "meta.interpolation.valen",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.valen" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.valen" } },
          "patterns": [{ "include": "source.valen" }]
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.valen",
      "match": "'([^'\\\\]|\\\\.)'",
      "captures": {
        "0": { "name": "string.quoted.single.valen" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.valen",
          "match": "\\b(if|else|match|for|in|while|loop|break|continue|return|safe|unsafe)\\b"
        },
        {
          "name": "keyword.other.valen",
          "match": "\\b(let|mut|package|import|as|self|super|this)\\b"
        }
      ]
    },
    "storage": {
      "patterns": [
        {
          "name": "storage.type.valen",
          "match": "\\b(fn|class|data|enum|trait|impl|typealias|newtype|annotation)\\b"
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.valen",
          "match": "\\b(pub|internal|private|open|override|abstract|sealed|inline|reified|ref|derives)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.valen", "match": "\\b(true|false|None|null)\\b" },
        { "name": "support.function.builtin.valen", "match": "\\b(Some|Ok|Err|println|print)\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.valen", "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*[lL]?\\b" },
        { "name": "constant.numeric.binary.valen", "match": "\\b0[bB][01][01_]*[lL]?\\b" },
        { "name": "constant.numeric.octal.valen", "match": "\\b0[oO][0-7][0-7_]*[lL]?\\b" },
        { "name": "constant.numeric.float.valen", "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?[fF]?\\b" },
        { "name": "constant.numeric.integer.valen", "match": "\\b[0-9][0-9_]*[lL]?\\b" }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.valen",
          "match": "\\b(Int|Long|Float|Double|Bool|Char|Byte|Short|String|Unit|Nothing|Any)\\b"
        },
        {
          "name": "support.type.stdlib.valen",
          "match": "\\b(Option|Result|List|Map|Set|Iterator|Error|JavaException)\\b"
        },
        {
          "name": "entity.name.type.valen",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.valen" },
            "2": { "name": "entity.name.function.valen" }
          }
        },
        {
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.call.valen" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.comparison.valen", "match": "===|!==|==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.assignment.valen", "match": "\\+=|-=|\\*=|/=|%=|=" },
        { "name": "keyword.operator.arithmetic.valen", "match": "\\+|-|\\*|/|%" },
        { "name": "keyword.operator.logical.valen", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.bitwise.valen", "match": "&|\\||\\^|<<|>>" },
        { "name": "keyword.operator.pipeline.valen", "match": "\\|>" },
        { "name": "keyword.operator.range.valen", "match": "\\.\\.\\.|\\.\\.|\\.\\.=" },
        { "name": "keyword.operator.arrow.valen", "match": "->|=>" },
        { "name": "keyword.operator.try.valen", "match": "\\?" },
        { "name": "keyword.operator.scope.valen", "match": "::" },
        { "name": "keyword.operator.annotation.valen", "match": "@" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.bracket.round.valen", "match": "[()]" },
        { "name": "punctuation.bracket.curly.valen", "match": "[{}]" },
        { "name": "punctuation.bracket.square.valen", "match": "[\\[\\]]" },
        { "name": "punctuation.separator.valen", "match": "[,;]" },
        { "name": "punctuation.accessor.valen", "match": "\\." }
      ]
    },
    "identifiers": {
      "patterns": [
        { "name": "variable.other.valen", "match": "\\b[a-z_][a-zA-Z0-9_]*\\b" }
      ]
    }
  }
}
